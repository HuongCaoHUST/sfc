FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Cài đặt công cụ nền tảng và các gói phát triển GStreamer + OpenCV
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    wget \
    curl \
    pkg-config \
    libgstreamer1.0-0 \
    gstreamer1.0-libav \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-tools \
    gstreamer1.0-rtsp \
    libgstrtspserver-1.0-dev \
    libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

# Tải và cấu hình ONNX Runtime GPU (v1.18.1) tương tự như Dockerfile của app main.cpp
ENV ORT_VERSION=1.18.1
ENV ORT_DIR=/opt/onnxruntime
RUN wget -qO ort.tgz https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu-${ORT_VERSION}.tgz && \
    tar -xzf ort.tgz && \
    mv onnxruntime-linux-x64-gpu-${ORT_VERSION} ${ORT_DIR} && \
    rm ort.tgz

# Bật đường dẫn thư viện ONNX Runtime và CUDA
ENV ORT_ROOT=${ORT_DIR}
ENV LD_LIBRARY_PATH=${ORT_DIR}/lib:/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64:${LD_LIBRARY_PATH}
ENV PATH=/usr/local/cuda/bin:${PATH}

# GStreamer Configuration
ENV GST_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/gstreamer-1.0/

# Copy các plugin GStreamer đã compiled
# LƯU Ý QUAN TRỌNG: Nếu gặp lỗi GLIBC khi tải plugin do chênh lệch hệ điều hành (Host Ubuntu 24.04 vs Docker Ubuntu 22.04) 
# Bạn hãy re-build file C++ của gst-plugin TRONG môi trường của container Ubuntu 22.04 này (hoặc container onnx_detection_gpu của bạn) để đồng bộ thư viện C.
COPY builddir/gst-plugin/libgstmyfilter.so /usr/lib/x86_64-linux-gnu/gstreamer-1.0/ || true
COPY builddir/gst-plugin/libgstyolodetection.so /usr/lib/x86_64-linux-gnu/gstreamer-1.0/ || true
COPY builddir/gst-plugin/libgstyolobatchdetection.so /usr/lib/x86_64-linux-gnu/gstreamer-1.0/ || true
COPY builddir/gst-plugin/libgstyolojsonoverlay.so /usr/lib/x86_64-linux-gnu/gstreamer-1.0/ || true
COPY builddir/gst-plugin/libgstyoloforward.so /usr/lib/x86_64-linux-gnu/gstreamer-1.0/ || true
COPY builddir/gst-plugin/libgstyolobackend.so /usr/lib/x86_64-linux-gnu/gstreamer-1.0/ || true

# ONNX Runtime GPU Optimization Config
ENV ORT_CUDA_DEVICE_ORDINAL=0
ENV ORT_CUDA_CUDNN_CONV_ALGO_SEARCH=DEFAULT

CMD ["gst-inspect-1.0"]
